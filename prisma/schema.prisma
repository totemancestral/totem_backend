generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TotemOrderStatus {
  pending
  processing
  done
  error
}

enum TotemOffer {
  origine
  ancestral
  famille
}

enum TotemPipelineStep {
  texte
  image
  audio
  pdf
  upload
  email
  pipeline
}

model UserProfile {
  id        String   @id
  role      UserRole @default(adulte)
  firstName String?
  locale    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  juniorTotems  JuniorTotem[]
}

enum UserRole {
  adulte
  junior
}

model JuniorTotem {
  id          String   @id @default(cuid())
  userId      String
  answers     Json
  scores      Json
  dominant    String
  secondary   String
  totemName   String
  quality     String
  phrase      String
  orderNumber Int
  shareCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TotemOrder {
  id                  String               @id @default(cuid())
  userId              String
  customerEmail       String?
  customerName        String?
  checkoutSessionId   String               @unique
  paymentIntentId     String?              @unique
  status              TotemOrderStatus     @default(pending)
  locale              String?
  offer               TotemOffer           @default(ancestral)
  amountCents         Int?
  currency            String?
  country             String?
  answers             Json
  textPayload         Json?
  archetypeId         String?
  ancestralName       String?
  imageKey            String?
  audioKey            String?
  pdfKey              String?
  parchmentKey        String?
  certificateKey      String?
  imageUrl            String?
  audioUrl            String?
  pdfUrl              String?
  parchmentUrl        String?
  certificateUrl      String?
  errorMessage        String?
  attempts            Int                  @default(0)
  queuedAt            DateTime?
  processingAt        DateTime?
  completedAt         DateTime?
  deliveryEmailSentAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  pipelineErrors      TotemPipelineError[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([offer, createdAt])
  @@index([country])
}

model TotemPipelineError {
  id         String            @id @default(cuid())
  orderId    String
  step       TotemPipelineStep @default(pipeline)
  code       String?
  message    String
  attempts   Int
  resolved   Boolean           @default(false)
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  order TotemOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([resolved, createdAt])
}
